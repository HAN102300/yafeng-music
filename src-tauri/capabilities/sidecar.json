{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "sidecar-remote",
  "description": "permissions for the sidecar-served UI (127.0.0.1 any port)",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": [
      "http://127.0.0.1:*/*",
      "http://localhost:*/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:event:default",
    "store:default",
    "updater:default",
    "process:allow-restart"
  ]
}
