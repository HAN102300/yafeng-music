{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YaFengMusic",
  "version": "0.1.2",
  "identifier": "com.yafeng.music",
  "build": {
    "frontendDist": "http://localhost:3000",
    "devUrl": "http://localhost:3000"
  },
  "app": {
    "windows": [
      {
        "title": "雅枫音乐",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/node"
    ],
    "resources": {
      "resources/next-server/": "resources/next-server/"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxQTk1RThGNURCNDg1ODIKUldTQ2hiUmRqMTZwd1hvOC9FRU5EQ2RRZDl0KzBXZzlMdStrUlRFTHdJL0gyVHJtMk5IQ3FYY0UK",
      "endpoints": [
        "https://github.com/HAN102300/yafeng-music/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
